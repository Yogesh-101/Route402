# Route402 Core Router & Algorand Configuration

# Router Server Port
PORT=4000

# Target Algorand Network ('testnet' or 'mainnet')
ALGORAND_NETWORK=testnet

# Algorand Sponsor Vault Secret Key Mnemonic (25-word seed phrase)
# Required for signing fee sponsorship transactions on MainNet/TestNet.
# If left blank, a demo keypair will be generated automatically.
SPONSOR_MNEMONIC=""

# Algorand Node Connection Config (Algod API)
ALGOD_SERVER="https://testnet-api.algonode.cloud"
ALGOD_PORT=443
ALGOD_TOKEN=""

# SQLite Database Persistence Path
DATABASE_PATH="route402.db"
